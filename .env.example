# exa server configuration. Copy to .env (never commit .env).

# --- core ---
PORT=4317
EXA_HOST=0.0.0.0
EXA_PUBLIC_URL=http://localhost:4317
# 32+ random chars: openssl rand -base64 48
EXA_JWT_SECRET=
# BYOK envelope-encryption master key (32 bytes base64): openssl rand -base64 32
# Rotate by listing versions: EXA_MASTER_KEYS="1:<old>,2:<new>" (highest = current)
EXA_MASTER_KEY=

# --- database ---
# Postgres (recommended for multi-user). Without it, an embedded Postgres (PGlite) is used in EXA_DATA_DIR.
DATABASE_URL=postgres://exa:exa@localhost:5432/exa
EXA_DATA_DIR=./data

# --- auth ---
# Dev-only email login (creates orgs on first use). NEVER enable in production.
EXA_DEV_AUTH=0
# OIDC SSO: users sign in with an ID token from your IdP
EXA_OIDC_ISSUER=
EXA_OIDC_AUDIENCE=exa
# ID-token claim holding the org slug (auto-creates orgs). Or set a single default org:
EXA_OIDC_TENANT_CLAIM=
EXA_OIDC_DEFAULT_TENANT=

# --- the "exa" model: platform pool keys (any subset) ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
# Optional: JSON array (or path to a JSON file) replacing the default backend pool
EXA_BACKENDS=

# --- light-client sandbox ---
# "docker" gives server-loop chats a network-less container per session for shell commands
EXA_SANDBOX_SHELL=none
EXA_SANDBOX_IMAGE=oven/bun:1-debian

# --- retention ---
# usage/audit months kept (content retention is a per-org setting: retention.contentDays)
EXA_USAGE_RETENTION_MONTHS=13
