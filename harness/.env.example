# Copy to .env and fill in. Never commit .env.
# Bedrock FIRST: set one auth shape below + region, then AGENT_MODEL stays bedrock/... .

# --- Amazon Bedrock (pick A or B) ---
# A: Bedrock API key (simplest) — Bedrock console > API keys
AWS_BEARER_TOKEN_BEDROCK=
# B: SigV4 IAM credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only for temporary/STS credentials
# Region for bedrock-runtime endpoint (BEDROCK_REGION wins over AWS_REGION)
BEDROCK_REGION=us-east-1
# AWS_REGION=

# --- Other providers (BYOK, optional — add only what you use) ---
# Aggregator: 1 key covers 200+ models (fallback path)
OPENROUTER_API_KEY=
# Direct provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_KEY=
# GEMINI_API_KEY=  # alias of GOOGLE_GENERATIVE_AI_KEY
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Model slug. Bedrock slugs are bedrock/<full-bedrock-model-id>.
# Default is Haiku 4.5 (light + fast, near-frontier). Swap the id for heavier
# models, e.g. bedrock/us.anthropic.claude-sonnet-4-6. Confirm IDs for your region:
#   aws bedrock list-foundation-models --region=us-east-1 --by-provider anthropic
# Same context pipeline (CLAUDE.md + session + tools) for every provider.
AGENT_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0

DATABASE_URL=
